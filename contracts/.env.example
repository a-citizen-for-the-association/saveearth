# Copy to .env and fill in. Never commit the real .env (already gitignored).
#
# Key management: prefer Foundry's encrypted keystore over a plaintext
# private key in .env.
#   cast wallet import <account-name> --interactive
#   forge script ... --account <account-name>
# A raw PRIVATE_KEY env var is only for CI where a keystore isn't practical.

# Address that becomes the Owner (and genesis member) of the deployed
# contracts. Required by script/Deploy.s.sol. Does not have to be the
# deploying/broadcasting account.
OWNER_ADDRESS=

# Ethereum. Bring your own provider (Alchemy/Infura/etc); Foundry has no
# reliable public default for these.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=

# Polkadot Hub. Optional — Foundry ships built-in defaults for the
# `polkadot` / `polkadot-testnet` chain names (see ADR-0003). Set these only
# to override with your own endpoint.
POLKADOT_HUB_RPC_URL=
POLKADOT_HUB_TESTNET_RPC_URL=

# For `forge script --verify` on Ethereum chains.
ETHERSCAN_API_KEY=

# CI-only fallback — see the key management note above.
# PRIVATE_KEY=
