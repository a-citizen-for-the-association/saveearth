# Copy to .env.local and fill in per environment. Never commit the real file.
#
# One pair (Membership + CommunityBoard address) per chain id. Leave a
# chain's pair unset if it has no deployment yet — the UI shows a "not
# deployed" state instead of crashing (Definition of Done golden path 8).
# Values come from contracts/deployments/<chainId>.json after running
# contracts/script/Deploy.s.sol.

# Ethereum Mainnet (1)
NEXT_PUBLIC_MEMBERSHIP_ADDRESS_1=
NEXT_PUBLIC_COMMUNITY_BOARD_ADDRESS_1=

# Ethereum Sepolia (11155111)
NEXT_PUBLIC_MEMBERSHIP_ADDRESS_11155111=
NEXT_PUBLIC_COMMUNITY_BOARD_ADDRESS_11155111=

# Polkadot Hub Mainnet (420420419)
NEXT_PUBLIC_MEMBERSHIP_ADDRESS_420420419=
NEXT_PUBLIC_COMMUNITY_BOARD_ADDRESS_420420419=

# Polkadot Hub Testnet (420420417)
NEXT_PUBLIC_MEMBERSHIP_ADDRESS_420420417=
NEXT_PUBLIC_COMMUNITY_BOARD_ADDRESS_420420417=
